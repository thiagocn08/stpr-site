<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Seminário Teológico Presbiteriano Reformado: STPR</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700;9..144,900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --navy: #1B2A4A;
    --navy-deep: #131F38;
    --cream: #F2E9D8;
    --cream-light: #F8F2E6;
    --gold: #B8923E;
    --gold-light: #D4B574;
    --seal: #8B1A1A;
    --stone: #5A5448;
    --rule: #D9CDB0;
    --rule-dark: #C2B594;

    --display: 'Fraunces', serif;
    --body: 'Source Serif 4', serif;
    --utility: 'Inter', sans-serif;
  }

  *{ margin:0; padding:0; box-sizing:border-box; }

  html{ scroll-behavior:smooth; }

  body{
    background:var(--cream);
    color:var(--navy);
    font-family:var(--body);
    font-size:18px;
    line-height:1.65;
    -webkit-font-smoothing:antialiased;
  }

  a{ color:inherit; text-decoration:none; }

  img{ max-width:100%; display:block; }

  .wrap{
    max-width:1080px;
    margin:0 auto;
    padding:0 32px;
  }

  /* ---------- Reduced motion ---------- */
  @media (prefers-reduced-motion: reduce){
    *{ animation:none !important; transition:none !important; scroll-behavior:auto !important; }
  }

  /* ---------- Header / Nav ---------- */
  header{
    position:sticky;
    top:0;
    z-index:50;
    background:rgba(242,233,216,0.94);
    backdrop-filter:blur(6px);
    border-bottom:1px solid var(--rule-dark);
  }
  .nav-inner{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:14px 32px;
    max-width:1080px;
    margin:0 auto;
  }
  .brand{
    display:flex;
    align-items:center;
    gap:12px;
  }
  .brand img{ height:46px; width:46px; object-fit:contain; }
  .brand-text{
    font-family:var(--utility);
    font-weight:600;
    font-size:14px;
    letter-spacing:0.08em;
    color:var(--navy);
    line-height:1.3;
  }
  .brand-text .full{
    display:block;
    font-weight:400;
    font-size:11px;
    letter-spacing:0.05em;
    color:var(--stone);
    margin-top:2px;
  }
  nav ul{
    display:flex;
    gap:30px;
    list-style:none;
  }
  nav a{
    font-family:var(--utility);
    font-size:13px;
    font-weight:500;
    letter-spacing:0.06em;
    text-transform:uppercase;
    color:var(--navy);
    position:relative;
    padding-bottom:4px;
  }
  nav a::after{
    content:'';
    position:absolute;
    left:0; bottom:0;
    width:0; height:1px;
    background:var(--gold);
    transition:width 0.25s ease;
  }
  nav a:hover::after{ width:100%; }
  .nav-toggle{ display:none; }

  @media (max-width:760px){
    nav ul{ display:none; }
    .nav-toggle{
      display:block;
      font-family:var(--utility);
      font-size:13px;
      letter-spacing:0.06em;
      text-transform:uppercase;
      border:1px solid var(--navy);
      padding:8px 14px;
      background:none;
      cursor:pointer;
      color:var(--navy);
    }
    nav.open ul{
      display:flex;
      flex-direction:column;
      gap:0;
      position:absolute;
      top:100%;
      left:0;
      right:0;
      background:var(--cream-light);
      border-bottom:1px solid var(--rule-dark);
      padding:8px 32px 18px;
    }
    nav.open ul li{ padding:10px 0; border-bottom:1px solid var(--rule); }
    nav.open ul li:last-child{ border-bottom:none; }
  }

  /* ---------- Hero ---------- */
  .hero{
    position:relative;
    padding:96px 32px 110px;
    text-align:center;
    overflow:hidden;
  }
  .hero::before{
    content:'';
    position:absolute;
    inset:0;
    background:
      radial-gradient(ellipse at 50% -10%, rgba(184,146,62,0.14), transparent 60%);
    pointer-events:none;
  }
  .hero-logo{
    width:128px;
    height:128px;
    margin:0 auto 28px;
    object-fit:contain;
    animation:rise 0.9s ease both;
  }
  .hero-eyebrow{
    font-family:var(--utility);
    font-size:12.5px;
    font-weight:600;
    letter-spacing:0.18em;
    text-transform:uppercase;
    color:var(--gold);
    margin-bottom:18px;
    animation:rise 0.9s ease 0.1s both;
  }
  .hero h1{
    font-family:var(--display);
    font-weight:600;
    font-size:clamp(2.4rem, 5.4vw, 4.1rem);
    line-height:1.08;
    color:var(--navy);
    max-width:760px;
    margin:0 auto 22px;
    animation:rise 0.9s ease 0.18s both;
  }
  .hero h1 em{
    font-style:italic;
    font-weight:500;
    color:var(--seal);
  }
  .hero p.lede{
    font-family:var(--body);
    font-size:19px;
    color:var(--stone);
    max-width:600px;
    margin:0 auto 38px;
    animation:rise 0.9s ease 0.26s both;
  }
  .hero-ctas{
    display:flex;
    gap:18px;
    justify-content:center;
    flex-wrap:wrap;
    animation:rise 0.9s ease 0.34s both;
  }
  .btn{
    display:inline-block;
    font-family:var(--utility);
    font-size:13.5px;
    font-weight:600;
    letter-spacing:0.05em;
    text-transform:uppercase;
    padding:14px 30px;
    border:1px solid var(--navy);
    transition:background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .btn-primary{ background:var(--navy); color:var(--cream-light); }
  .btn-primary:hover{ background:var(--navy-deep); transform:translateY(-1px); }
  .btn-secondary{ background:transparent; color:var(--navy); }
  .btn-secondary:hover{ background:var(--navy); color:var(--cream-light); }

  @keyframes rise{
    from{ opacity:0; transform:translateY(16px); }
    to{ opacity:1; transform:translateY(0); }
  }

  /* ---------- Section scaffolding ---------- */
  section{ padding:84px 0; }
  .section-alt{ background:var(--cream-light); border-top:1px solid var(--rule); border-bottom:1px solid var(--rule); }
  .section-dark{ background:var(--navy); color:var(--cream-light); }

  .eyebrow{
    font-family:var(--utility);
    font-size:12px;
    font-weight:600;
    letter-spacing:0.16em;
    text-transform:uppercase;
    color:var(--gold);
    margin-bottom:14px;
    display:block;
  }
  .section-dark .eyebrow{ color:var(--gold-light); }

  h2.section-title{
    font-family:var(--display);
    font-weight:600;
    font-size:clamp(1.7rem, 3.4vw, 2.5rem);
    line-height:1.18;
    margin-bottom:20px;
    max-width:680px;
  }

  .section-head{ margin-bottom:52px; }
  .section-head p{
    font-size:17.5px;
    color:var(--stone);
    max-width:620px;
  }
  .section-dark .section-head p{ color:#C7CEDA; }

  /* ---------- Epigraph (signature element) ---------- */
  .epigraph{
    border-left:3px solid var(--gold);
    padding:6px 0 6px 26px;
    margin:36px 0;
    max-width:640px;
  }
  .epigraph p{
    font-family:var(--display);
    font-style:italic;
    font-size:1.25rem;
    line-height:1.5;
    color:var(--navy);
    margin-bottom:8px;
  }
  .epigraph cite{
    font-family:var(--utility);
    font-style:normal;
    font-size:12px;
    font-weight:600;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:var(--seal);
  }
  .section-dark .epigraph p{ color:var(--cream-light); }
  .section-dark .epigraph{ border-left-color:var(--gold-light); }

  /* ---------- Six pillars ---------- */
  .pillars{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:1px;
    background:var(--rule-dark);
    border:1px solid var(--rule-dark);
  }
  .pillar{
    background:var(--cream);
    padding:36px 30px;
  }
  .pillar .mark{
    font-family:var(--display);
    font-size:13px;
    letter-spacing:0.08em;
    color:var(--gold);
    margin-bottom:14px;
  }
  .pillar h3{
    font-family:var(--display);
    font-weight:600;
    font-size:1.2rem;
    margin-bottom:10px;
    color:var(--navy);
  }
  .pillar p{
    font-size:15.5px;
    color:var(--stone);
    line-height:1.6;
  }
  @media (max-width:760px){
    .pillars{ grid-template-columns:1fr; }
  }

  /* ---------- Order statement ---------- */
  .order-statement{
    text-align:center;
    padding:70px 0;
  }
  .order-flow{
    display:flex;
    align-items:center;
    justify-content:center;
    flex-wrap:wrap;
    gap:10px;
    max-width:820px;
    margin:0 auto;
    font-family:var(--utility);
    font-size:13.5px;
    font-weight:600;
    letter-spacing:0.04em;
    text-transform:uppercase;
  }
  .order-flow span.step{
    color:var(--navy);
    padding:10px 16px;
    border:1px solid var(--rule-dark);
    background:var(--cream-light);
  }
  .order-flow span.arrow{
    color:var(--gold);
    font-size:16px;
  }
  @media (max-width:700px){
    .order-flow{ flex-direction:column; }
    .order-flow span.arrow{ transform:rotate(90deg); }
  }

  /* ---------- Year progression (home) ---------- */
  .year-flow{
    display:grid;
    grid-template-columns:repeat(4, 1fr);
    gap:1px;
    background:var(--rule-dark);
    border:1px solid var(--rule-dark);
  }
  .year-flow .yf{
    background:var(--cream);
    padding:28px 24px 26px;
    position:relative;
    transition:background 0.2s ease;
  }
  .year-flow .yf:hover{ background:var(--cream-light); }
  .year-flow .yf:not(:last-child)::after{
    content:'→';
    position:absolute;
    right:-9px; top:30px;
    width:18px; height:18px;
    background:var(--cream-light);
    color:var(--gold);
    font-size:13px;
    line-height:18px;
    text-align:center;
    z-index:1;
  }
  .yf-num{
    font-family:var(--display);
    font-weight:700;
    font-size:2rem;
    color:var(--gold);
    line-height:1;
    margin-bottom:12px;
  }
  .yf-label{
    display:block;
    font-family:var(--utility);
    font-size:11px;
    font-weight:600;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:var(--seal);
    margin-bottom:6px;
  }
  .yf h3{
    font-family:var(--display);
    font-weight:600;
    font-size:1.08rem;
    line-height:1.3;
    color:var(--navy);
    margin-bottom:10px;
  }
  .yf p{
    font-size:14.5px;
    line-height:1.55;
    color:var(--stone);
  }
  @media (max-width:900px){ .year-flow{ grid-template-columns:1fr 1fr; } .year-flow .yf::after{ display:none; } }
  @media (max-width:560px){ .year-flow{ grid-template-columns:1fr; } }

  /* ---------- Curriculum (years/semesters) ---------- */
  .year-block{
    margin-bottom:64px;
  }
  .year-block:last-child{ margin-bottom:0; }
  .year-head{
    display:flex;
    align-items:baseline;
    gap:18px;
    border-bottom:2px solid var(--navy);
    padding-bottom:14px;
    margin-bottom:30px;
  }
  .year-num{
    font-family:var(--display);
    font-weight:700;
    font-size:2.6rem;
    color:var(--gold);
    line-height:1;
  }
  .year-titles h3{
    font-family:var(--display);
    font-weight:600;
    font-size:1.5rem;
    color:var(--navy);
  }
  .year-titles span{
    font-family:var(--utility);
    font-size:12px;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:var(--stone);
  }
  .semesters{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:38px;
  }
  @media (max-width:760px){
    .semesters{ grid-template-columns:1fr; }
  }
  .semester h4{
    font-family:var(--utility);
    font-size:12.5px;
    font-weight:600;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:var(--seal);
    margin-bottom:16px;
    padding-bottom:8px;
    border-bottom:1px solid var(--rule);
  }
  .semester ul{
    list-style:none;
  }
  .semester li{
    font-family:var(--body);
    font-size:16px;
    color:var(--navy);
    padding:9px 0;
    border-bottom:1px solid var(--rule);
    display:flex;
    gap:10px;
  }
  .semester li:last-child{ border-bottom:none; }
  .semester li::before{
    content:'§';
    color:var(--gold);
    font-weight:600;
    flex-shrink:0;
  }
  .year-objective{
    margin-top:26px;
    font-family:var(--display);
    font-style:italic;
    font-size:16.5px;
    color:var(--stone);
    padding-top:18px;
    border-top:1px dashed var(--rule-dark);
  }
  .year-objective strong{
    font-style:normal;
    color:var(--navy);
    font-weight:600;
  }
  .semester-note{
    margin-top:16px;
    padding:14px 16px;
    background:var(--cream-light);
    border-left:2px solid var(--gold);
    font-family:var(--body);
    font-size:14.5px;
    line-height:1.55;
    color:var(--stone);
  }
  .semester li .n{
    font-family:var(--utility);
    font-size:11px;
    font-weight:600;
    color:var(--stone);
    min-width:16px;
    padding-top:4px;
    flex-shrink:0;
  }

  /* ---------- Languages table ---------- */
  .lang-table{
    width:100%;
    border-collapse:collapse;
    border:1px solid var(--rule-dark);
    background:var(--cream);
  }
  .lang-table th{
    font-family:var(--utility);
    font-size:12px;
    font-weight:600;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:var(--seal);
    text-align:left;
    padding:16px 22px;
    border-bottom:2px solid var(--navy);
    background:var(--cream-light);
  }
  .lang-table td{
    font-family:var(--body);
    font-size:16px;
    color:var(--navy);
    padding:18px 22px;
    border-bottom:1px solid var(--rule);
    vertical-align:top;
  }
  .lang-table tr:last-child td{ border-bottom:none; }
  .lang-table td.lang{
    font-family:var(--display);
    font-weight:600;
    font-size:1.15rem;
    white-space:nowrap;
  }
  .lang-table td.sems{
    font-family:var(--utility);
    font-size:14px;
    font-weight:500;
    letter-spacing:0.04em;
    white-space:nowrap;
  }
  .sem-dots{ display:flex; gap:6px; margin-top:8px; }
  .sem-dots i{
    width:14px; height:14px;
    border:1px solid var(--rule-dark);
    background:var(--cream-light);
    display:block;
  }
  .sem-dots i.on{ background:var(--gold); border-color:var(--gold); }
  @media (max-width:700px){
    .lang-table th:nth-child(3), .lang-table td:nth-child(3){ display:none; }
  }

  /* ---------- Complements with distribution ---------- */
  .complements-dist{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:1px;
    background:var(--rule-dark);
    border:1px solid var(--rule-dark);
  }
  @media (max-width:900px){ .complements-dist{ grid-template-columns:1fr 1fr; } }
  @media (max-width:560px){ .complements-dist{ grid-template-columns:1fr; } }
  .complements-dist .complement{ border:none; padding:28px 24px; }
  .complements-dist .complement h3{
    font-family:var(--display);
    font-weight:600;
    font-size:1.1rem;
    color:var(--navy);
    margin-bottom:10px;
    line-height:1.3;
  }
  .complements-dist .complement p{
    font-size:15px;
    color:var(--stone);
  }

  /* ---------- Complementary components ---------- */
  .complements{
    display:grid;
    grid-template-columns:repeat(4, 1fr);
    gap:24px;
    margin-top:14px;
  }
  @media (max-width:900px){ .complements{ grid-template-columns:repeat(2,1fr); } }
  @media (max-width:560px){ .complements{ grid-template-columns:1fr; } }
  .complement{
    border:1px solid var(--rule-dark);
    padding:24px 20px;
    background:var(--cream);
  }
  .complement .num{
    font-family:var(--display);
    font-size:13px;
    color:var(--gold);
    margin-bottom:10px;
  }
  .complement p{
    font-family:var(--body);
    font-size:15.5px;
    color:var(--navy);
    line-height:1.5;
  }

  .complements.five{ grid-template-columns:repeat(5, 1fr); margin-bottom:34px; }
  .complements.five .complement h3{
    font-family:var(--display); font-weight:600; font-size:1.02rem; line-height:1.3;
    color:var(--navy); margin-bottom:8px;
  }
  .complements.five .complement p{ font-size:14.5px; color:var(--stone); }
  @media (max-width:1000px){ .complements.five{ grid-template-columns:repeat(3,1fr); } }
  @media (max-width:700px){ .complements.five{ grid-template-columns:1fr 1fr; } }
  @media (max-width:480px){ .complements.five{ grid-template-columns:1fr; } }
  .about-side li small{
    display:block; font-family:var(--utility); font-size:12px; letter-spacing:0.02em;
    color:var(--stone); margin-top:3px;
  }
  .authors-strip .authors-list span:nth-last-child(2)::after{ content:','; margin-left:0; color:var(--navy); }
  .authors-list span.etc{ font-style:italic; color:var(--stone); }

  /* ---------- Authors strip ---------- */
  .authors-strip{
    margin-top:60px;
    padding-top:40px;
    border-top:1px solid var(--rule-dark);
  }
  .authors-strip h4{
    font-family:var(--utility);
    font-size:12.5px;
    font-weight:600;
    letter-spacing:0.12em;
    text-transform:uppercase;
    color:var(--stone);
    margin-bottom:22px;
  }
  .authors-list{
    display:flex;
    flex-wrap:wrap;
    gap:14px 30px;
  }
  .authors-list span{
    font-family:var(--display);
    font-style:italic;
    font-size:17px;
    color:var(--navy);
    white-space:nowrap;
  }
  .authors-list span:not(:last-child)::after{
    content:'·';
    margin-left:30px;
    color:var(--gold);
    font-style:normal;
  }

  /* ---------- About page sections ---------- */
  .about-grid{
    display:grid;
    grid-template-columns:1.1fr 0.9fr;
    gap:64px;
    align-items:start;
  }
  @media (max-width:800px){ .about-grid{ grid-template-columns:1fr; gap:40px; } }
  .about-grid h2{
    font-family:var(--display);
    font-weight:600;
    font-size:1.9rem;
    margin-bottom:22px;
    color:var(--navy);
  }
  .about-grid p{
    font-size:17px;
    color:var(--navy);
    margin-bottom:18px;
  }
  .about-side{
    background:var(--cream-light);
    border:1px solid var(--rule-dark);
    padding:32px 28px;
  }
  .about-side h4{
    font-family:var(--utility);
    font-size:12px;
    font-weight:600;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:var(--seal);
    margin-bottom:18px;
  }
  .about-side ul{ list-style:none; }
  .about-side li{
    font-family:var(--body);
    font-size:15.5px;
    color:var(--navy);
    padding:10px 0;
    border-bottom:1px solid var(--rule);
  }
  .about-side li:last-child{ border-bottom:none; }

  /* ---------- Footer / Contact ---------- */
  footer{
    background:var(--navy-deep);
    color:var(--cream-light);
    padding:70px 0 36px;
  }
  .footer-grid{
    display:grid;
    grid-template-columns:1.2fr 1fr 1fr;
    gap:48px;
    margin-bottom:54px;
  }
  @media (max-width:760px){ .footer-grid{ grid-template-columns:1fr; gap:36px; } }
  .footer-brand{
    display:flex;
    align-items:center;
    gap:14px;
    margin-bottom:16px;
  }
  .footer-brand img{ height:72px; width:72px; object-fit:contain; }
  .footer-brand-text{
    font-family:var(--display);
    font-weight:600;
    font-size:1.1rem;
  }
  .footer-brand-text{
  font-family:var(--display);
  font-weight:600;
  font-size:1.1rem;
  color:var(--gold-light);
}
  .footer-brand-text span{
    display:block;
    font-family:var(--utility);
    font-weight:400;
    font-size:11px;
    letter-spacing:0.06em;
    color:#9AA6BC;
    margin-top:3px;
  }
  footer p.desc{
    font-size:15px;
    color:#B8C0D1;
    max-width:320px;
    line-height:1.6;
  }
  footer h5{
