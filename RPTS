<script>
  function goTo(page){
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.getElementById('page-' + page).classList.add('active');
    window.scrollTo({top:0, behavior:'smooth'});
    document.querySelector('nav').classList.remove('open');
  }

  const WHATSAPP = '5522997847992';
  function openWhatsApp(text){
    window.open('https://wa.me/' + WHATSAPP + '?text=' + encodeURIComponent(text), '_blank', 'noopener');
  }

  function handleSubmit(e){
    e.preventDefault();
    const f = e.target;
    const text = '*Contato pelo site do STPR*\n\n' +
      '*Nome:* ' + f.nome.value.trim() + '\n' +
      '*E-mail:* ' + f.email.value.trim() + '\n\n' +
      f.mensagem.value.trim();
    openWhatsApp(text);
    const status = document.getElementById('formStatus');
    status.textContent = 'Sua mensagem foi aberta no WhatsApp. Basta tocar em enviar.';
    status.style.color = '#1B2A4A';
    status.classList.add('show');
  }

  /* CPF: máscara e validação dos dígitos verificadores */
  const cpfInput = document.getElementById('c-cpf');
  cpfInput.addEventListener('input', () => {
    let d = cpfInput.value.replace(/\D/g,'').slice(0,11);
    d = d.replace(/(\d{3})(\d)/,'$1.$2').replace(/(\d{3})(\d)/,'$1.$2').replace(/(\d{3})(\d{1,2})$/,'$1-$2');
    cpfInput.value = d;
    cpfInput.classList.remove('invalid');
  });
  function cpfValido(v){
    const c = v.replace(/\D/g,'');
    if (c.length !== 11 || /^(\d)\1{10}$/.test(c)) return false;
    for (let t = 9; t < 11; t++){
      let s = 0;
      for (let i = 0; i < t; i++) s += c[i] * (t + 1 - i);
      if (((10 * s) % 11) % 10 != c[t]) return false;
    }
    return true;
  }

  const telInput = document.getElementById('c-tel');
  telInput.addEventListener('input', () => {
    let d = telInput.value.replace(/\D/g,'').slice(0,11);
    if (d.length > 10) d = d.replace(/(\d{2})(\d{5})(\d{0,4})/,'($1) $2-$3');
    else if (d.length > 6) d = d.replace(/(\d{2})(\d{4})(\d{0,4})/,'($1) $2-$3');
    else if (d.length > 2) d = d.replace(/(\d{2})(\d{0,5})/,'($1) $2');
    telInput.value = d;
  });
  const vocacao = document.getElementById('c-vocacao');
  vocacao.addEventListener('input', () => { document.getElementById('c-count').textContent = vocacao.value.length; });

  function sendCandidatura(e){
    e.preventDefault();
    const $ = id => document.getElementById(id);
    const status = $('candStatus');
    const doc = document.querySelector('input[name="c-doc"]:checked').value;
    document.querySelectorAll('#candForm .invalid').forEach(i => i.classList.remove('invalid'));
    const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test($('c-email').value.trim());
    const checks = [
      [!$('c-nome').value.trim(), 'c-nome', 'Informe o nome completo.'],
      [!$('c-nasc').value, 'c-nasc', 'Informe a data de nascimento.'],
      [telInput.value.replace(/\D/g,'').length < 10, 'c-tel', 'Informe um telefone com DDD.'],
      [!$('c-rg').value.trim(), 'c-rg', 'Informe o número da identidade.'],
      [!cpfValido(cpfInput.value), 'c-cpf', 'Verifique o CPF informado.'],
      [!emailOk, 'c-email', 'Informe um e-mail válido.'],
      [!$('c-igreja').value.trim(), 'c-igreja', 'Informe a igreja de que é membro.'],
      [!$('c-pastor').value.trim(), 'c-pastor', 'Informe o pastor ou presidente do Conselho.'],
      [vocacao.value.trim().length < 100, 'c-vocacao', 'Relate sua experiência de vocação (mínimo de 100 caracteres).'],
      [!$('c-carta').checked, null, 'Confirme o envio da carta de recomendação do Conselho.'],
      [!$('c-entrevista').checked, null, 'Marque o aceite de contato para a entrevista.'],
      [!$('c-verdade').checked, null, 'Marque a declaração de veracidade das informações.'],
      [!$('c-ok').checked, null, 'Marque a autorização de uso dos dados.']
    ];
    status.style.display = 'block';
    for (const [falha, id, msg] of checks){
      if (falha){
        if (id){ $(id).classList.add('invalid'); $(id).focus(); }
        status.textContent = msg; status.style.color = 'var(--seal)';
        return;
      }
    }
    const nasc = $('c-nasc').value.split('-').reverse().join('/');
    const text = '*Candidatura: Bacharelado em Teologia Reformada Confessional (STPR)*\n\n' +
      '*I. Dados pessoais*\n' +
      'Nome completo: ' + $('c-nome').value.trim() + '\n' +
      'Data de nascimento: ' + nasc + '\n' +
      'Telefone: ' + telInput.value + '\n' +
      'Identidade (RG): ' + $('c-rg').value.trim() + '\n' +
      'CPF: ' + cpfInput.value + '\n' +
      'E-mail: ' + $('c-email').value.trim() + '\n\n' +
      '*II. Igreja local*\n' +
      'Igreja: ' + $('c-igreja').value.trim() + '\n' +
      'Pastor/Presidente do Conselho: ' + $('c-pastor').value.trim() + '\n\n' +
      '*III. Experiência de vocação*\n' + vocacao.value.trim() + '\n\n' +
      '*IV. Documentos (seguem em anexo)*\n' +
      '- ' + doc + '\n' +
      '- Carta de recomendação do Conselho\n\n' +
      '*V. Declarações*\n' +
      '- Aceito ser contatado para agendamento de entrevista.\n' +
      '- Declaro que as informações prestadas são verdadeiras.\n' +
      '- Autorizo o uso dos dados exclusivamente para o processo de admissão.';
    openWhatsApp(text);
    status.textContent = 'Sua candidatura foi aberta no WhatsApp. Anexe o ' + doc.toLowerCase() + ' e a carta de recomendação do Conselho na conversa e envie.';
    status.style.color = 'var(--navy)';
  }
</script>

